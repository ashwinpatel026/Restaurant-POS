// Master Database Schema for Multi-Tenant Architecture
// This database manages companies, dealers, locations, users, and master data templates

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

model Company {
  companyId        BigInt    @id @default(autoincrement()) @map("company_id")
  companyCode      String    @unique @map("company_code") @db.VarChar(100)
  companyName      String    @map("company_name") @db.VarChar(500)
  addressLine1     String?   @map("address_line1") @db.VarChar(500)
  addressLine2     String?   @map("address_line2") @db.VarChar(500)
  city             String?   @map("city") @db.VarChar(100)
  state            String?   @map("state") @db.VarChar(100)
  country          String?   @map("country") @db.VarChar(100)
  zipcode          String?   @map("zipcode") @db.VarChar(20)
  phone            String?   @map("phone") @db.VarChar(50)
  email            String?   @map("email") @db.VarChar(255)
  isActive         Int       @default(1) @map("is_active")
  createdOn        DateTime  @default(now()) @map("created_on")
  updatedOn        DateTime? @map("updated_on")

  @@map("tbl_company")
}

model Dealer {
  dealerId         BigInt    @id @default(autoincrement()) @map("dealer_id")
  dealerCode       String    @unique @map("dealer_code") @db.VarChar(100)
  dealerName       String    @map("dealer_name") @db.VarChar(500)
  companyId        BigInt?   @map("company_id")
  addressLine1     String?   @map("address_line1") @db.VarChar(500)
  addressLine2     String?   @map("address_line2") @db.VarChar(500)
  city             String?   @map("city") @db.VarChar(100)
  state            String?   @map("state") @db.VarChar(100)
  country          String?   @map("country") @db.VarChar(100)
  zipcode          String?   @map("zipcode") @db.VarChar(20)
  phone            String?   @map("phone") @db.VarChar(50)
  email            String?   @map("email") @db.VarChar(255)
  isActive         Int       @default(1) @map("is_active")
  createdOn        DateTime  @default(now()) @map("created_on")
  updatedOn        DateTime? @map("updated_on")

  @@index([companyId])
  @@map("tbl_dealer")
}

model Location {
  locationId       BigInt    @id @default(autoincrement()) @map("location_id")
  locationName     String    @map("location_name") @db.VarChar(500)
  companyId        BigInt?   @map("company_id")
  dealerId         BigInt?   @map("dealer_id")
  storeCode        String    @unique @map("store_code") @db.VarChar(100) // Used to filter data in location DB
  addressLine1     String?   @map("address_line1") @db.VarChar(500)
  addressLine2     String?   @map("address_line2") @db.VarChar(500)
  city             String?   @map("city") @db.VarChar(100)
  state            String?   @map("state") @db.VarChar(100)
  country          String?   @map("country") @db.VarChar(100)
  zipcode          String?   @map("zipcode") @db.VarChar(20)
  phone            String?   @map("phone") @db.VarChar(50)
  email            String?   @map("email") @db.VarChar(255)
  federalTaxId     String?   @map("federal_tax_id") @db.VarChar(20)
  socialSecurityNumber String? @map("social_security_number") @db.VarChar(15)
  entityType       Json?     @map("entity_type")
  isActive         Int       @default(1) @map("is_active")
  syncEnabled      Int       @default(1) @map("sync_enabled")
  lastSyncAt       DateTime? @map("last_sync_at")
  createdOn        DateTime  @default(now()) @map("created_on")
  updatedOn        DateTime? @map("updated_on")

  @@index([companyId])
  @@index([dealerId])
  @@index([storeCode])
  @@map("tbl_location")
}

// Master Admin for Master Dashboard Authentication
model Admin {
  adminId         BigInt      @id @default(autoincrement()) @map("admin_id")
  email           String      @unique @map("email") @db.VarChar(255)
  username        String      @unique @map("username") @db.VarChar(100)
  password        String      @map("password")
  firstName       String      @map("first_name") @db.VarChar(100)
  lastName        String      @map("last_name") @db.VarChar(100)
  role            AdminRole   @map("role")
  isActive        Boolean     @default(true) @map("is_active")
  lastLoginAt     DateTime?   @map("last_login_at")
  createdOn       DateTime    @default(now()) @map("created_on")
  updatedOn       DateTime?   @map("updated_on")

  @@index([email])
  @@index([username])
  @@map("tbl_admin")
}

model User {
  userId          BigInt      @id @default(autoincrement()) @map("user_id")
  email           String      @unique @map("email") @db.VarChar(255)
  username        String      @unique @map("username") @db.VarChar(100)
  password        String      @map("password")
  firstName       String      @map("first_name") @db.VarChar(100)
  lastName        String      @map("last_name") @db.VarChar(100)
  companyId       BigInt?     @map("company_id")
  dealerId        BigInt?     @map("dealer_id")
  locationId      BigInt?     @map("location_id")
  role            UserRole    @map("role")
  accessLevel     AccessLevel  @map("access_level")
  isActive        Boolean     @default(true) @map("is_active")
  createdOn       DateTime    @default(now()) @map("created_on")
  updatedOn       DateTime?   @map("updated_on")

  @@index([companyId])
  @@index([dealerId])
  @@index([locationId])
  @@index([email])
  @@index([username])
  @@map("tbl_user")
}

// Master Data Templates (for syncing to locations)
model MasterDataTemplate {
  templateId      BigInt    @id @default(autoincrement()) @map("template_id")
  templateName    String    @map("template_name") @db.VarChar(255)
  templateType    String    @map("template_type") @db.VarChar(100) // MENU_MASTER, CATEGORIES, ITEMS, MODIFIERS, etc.
  templateData    Json      @map("template_data") // Template configuration/data
  isActive        Int       @default(1) @map("is_active")
  createdOn       DateTime  @default(now()) @map("created_on")
  updatedOn       DateTime? @map("updated_on")

  @@index([templateType])
  @@index([isActive])
  @@map("tbl_master_data_template")
}

// Sync Logs for tracking data synchronization
model SyncLog {
  syncLogId       BigInt    @id @default(autoincrement()) @map("sync_log_id")
  locationId      BigInt    @map("location_id")
  storeCode       String    @map("store_code") @db.VarChar(100)
  syncType        String    @map("sync_type") @db.VarChar(50) // FULL, INCREMENTAL
  status          String    @map("status") @db.VarChar(50) // SUCCESS, FAILED, IN_PROGRESS
  recordsSynced   Int?      @map("records_synced")
  errorMessage    String?   @map("error_message") @db.Text
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@index([locationId])
  @@index([storeCode])
  @@index([status])
  @@index([startedAt])
  @@map("tbl_sync_log")
}

// Sync Log table for change detection (from migration)
model SyncLogChange {
  id            BigInt    @id @default(autoincrement()) @map("id")
  tableName     String    @map("table_name") @db.Text
  recordId      String    @map("record_id") @db.Uuid
  operation     String    @map("operation") @db.Text // INSERT / UPDATE / DELETE
  source        String    @map("source") @db.Text // server, terminal, website
  data          Json?     @map("data") @db.JsonB
  changeTime    DateTime  @default(now()) @map("change_time")
  syncStatus    Int       @default(0) @map("sync_status") // 0=pending, 1=processed, 2=failed
  locationCode  String?   @map("location_code") @db.VarChar(100)
  errorMessage  String?   @map("error_message") @db.Text
  retryCount    Int       @default(0) @map("retry_count")
  lastRetryAt   DateTime? @map("last_retry_at")
  syncedAt      DateTime? @map("synced_at")
  syncedBy      Int?      @map("synced_by")

  @@index([syncStatus, changeTime])
  @@index([tableName, recordId])
  @@index([locationCode])
  @@index([syncStatus, locationCode, tableName])
  @@map("sync_log")
}

// Sync Status table for tracking sync status per location/table
model SyncStatus {
  id                BigInt    @id @default(autoincrement()) @map("id")
  locationCode      String    @map("location_code") @db.VarChar(100)
  tableName         String    @map("table_name") @db.Text
  lastSyncTime      DateTime? @map("last_sync_time")
  lastSyncStatus    Int       @default(0) @map("last_sync_status") // 0=success, 1=failed
  totalRecordsSynced BigInt    @default(0) @map("total_records_synced")
  lastErrorMessage  String?   @map("last_error_message") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([locationCode, tableName])
  @@index([locationCode])
  @@index([tableName])
  @@map("sync_status")
}

enum AccessLevel {
  COMPANY   // Access all locations in company
  DEALER    // Access all locations in dealer
  LOCATION  // Access only specific location
}

enum AdminRole {
  SUPER_ADMIN      // Full access to all master operations
  COMPANY_ADMIN    // Manage companies, dealers, locations, users
  DEALER_ADMIN     // Manage dealers, locations, users
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  DEALER_ADMIN
  OUTLET_MANAGER
  CAPTAIN
  CASHIER
  KITCHEN_STAFF
}

// Master Data Models (without storeCode - these are templates synced to locations)

model MasterTimeEvent {
  id                     BigInt    @id @default(autoincrement()) @map("id")
  eventCode              String    @unique @map("Event_code") @db.VarChar(100)
  eventName              String    @map("EventName") @db.VarChar(100)
  globalPriceAmountAdd   Decimal?  @map("GlobalPrice_Amount_Add") @db.Decimal(18, 2)
  globalPriceAmountDisc  Decimal?  @map("GlobalPrice_Amount_Disc") @db.Decimal(18, 2)
  globalPricePerAdd      Decimal?  @map("GlobalPrice_Per_Add") @db.Decimal(18, 2)
  globalPricePerDisc     Decimal?  @map("GlobalPrice_Per_Disc") @db.Decimal(18, 2)
  monday                 String?   @map("Monday") @db.VarChar(50)
  monStartTime           String?   @map("Mon_StartTime") @db.VarChar(10)
  monEndTime             String?   @map("Mon_EndTime") @db.VarChar(10)
  tuesday                String?   @map("Tuesday") @db.VarChar(50)
  tueStartTime           String?   @map("Tue_StartTime") @db.VarChar(10)
  tueEndTime             String?   @map("Tue_EndTime") @db.VarChar(10)
  wednesday              String?   @map("Wednesday") @db.VarChar(50)
  wedStartTime           String?   @map("Wed_StartTime") @db.VarChar(10)
  wedEndTime             String?   @map("Wed_EndTime") @db.VarChar(10)
  thursday               String?   @map("Thursday") @db.VarChar(50)
  thuStartTime           String?   @map("Thu_StartTime") @db.VarChar(10)
  thuEndTime             String?   @map("Thu_EndTime") @db.VarChar(10)
  friday                 String?   @map("FriDay") @db.VarChar(50)
  friStartTime           String?   @map("Fri_StartTime") @db.VarChar(10)
  friEndTime             String?   @map("Fri_EndTime") @db.VarChar(10)
  saturday               String?   @map("Saturday") @db.VarChar(50)
  satStartTime           String?   @map("Sat_StartTime") @db.VarChar(10)
  satEndTime             String?   @map("Sat_EndTime") @db.VarChar(10)
  sunday                 String?   @map("SunDay") @db.VarChar(50)
  sunStartTime           String?   @map("Sun_StartTime") @db.VarChar(10)
  sunEndTime             String?   @map("Sun_EndTime") @db.VarChar(10)
  eventStartDate         DateTime? @map("Event_Start_Date") @db.Date
  eventEndDate           DateTime? @map("Event_End_Date") @db.Date
  isActive               Int       @default(1) @map("is_active")
  createdBy              BigInt?  @map("created_by")
  createdDate            DateTime @default(now()) @map("created_date")
  updatedBy              BigInt?  @map("updated_by")
  updatedOn              DateTime? @map("updated_on")
  syncId                 String    @unique @default(uuid()) @map("sync_id") @db.Uuid
  syncSource             String?   @default("server") @map("sync_source") @db.VarChar(20)

  @@map("tbl_master_time_events")
}

model MasterPrepZone {
  prepZoneId         BigInt    @id @default(autoincrement()) @map("prep_zone_id")
  prepZoneCode       String    @unique @map("prep_zone_code") @db.VarChar(100)
  prepZoneName       String?   @map("prep_zone_name") @db.VarChar(500)
  stationCode        String?   @map("station_code") @db.VarChar(100)
  isActive           Int       @default(1) @map("is_active")
  sendToExpediter    Int?      @map("send_to_expediter")
  alwaysPrintTicket  Int?      @map("always_print_ticket")
  printerCode        String?   @map("printer_code") @db.VarChar(100)
  backupPrinterCode  String?   @map("backup_printer_code") @db.VarChar(100)
  createdBy          BigInt?   @map("createdby")
  createdOn          DateTime  @default(now()) @map("createdon")
  updatedBy          BigInt?   @map("updatedby")
  updatedOn          DateTime? @map("updatedon")
  syncId             String    @unique @default(uuid()) @map("sync_id") @db.Uuid
  syncSource         String?   @default("server") @map("sync_source") @db.VarChar(20)

  @@map("tbl_master_prep_zone")
